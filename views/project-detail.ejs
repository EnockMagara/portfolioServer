<%
  var cs = project.caseStudy;
  var pageTitle = cs ? cs.headline : project.title;
  var pageDesc = cs ? cs.lede : project.description;
%>
<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="utf-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0, viewport-fit=cover">
  <title><%= project.shortTitle || project.title %> — Enock Mecheo</title>
  <meta name="description" content="<%= pageDesc %>">
  <meta name="author" content="Enock Mecheo">
  <meta property="og:type" content="article">
  <meta property="og:site_name" content="Enock Mecheo">
  <meta property="og:title" content="<%= pageTitle %>">
  <meta property="og:description" content="<%= pageDesc %>">
  <meta property="og:image" content="https://www.enockmecheo.com/assets/img/og-image.png">
  <link href="/assets/img/favicon.png" rel="icon">
  <link rel="preconnect" href="https://fonts.googleapis.com">
  <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
  <link href="https://fonts.googleapis.com/css2?family=Inter:wght@400;500;600&display=swap" rel="stylesheet">
  <link href="/assets/css/site.css" rel="stylesheet">
</head>
<body>
  <header class="site-header wrap wrap--narrow">
    <a href="/" class="brand">Enock Mecheo</a>
    <nav class="back-nav" aria-label="Site">
      <a href="/#work">← All work</a>
    </nav>
  </header>

  <main>
  <% if (cs) { %>
    <section class="cs-hero wrap wrap--narrow">
      <div class="eyebrow">Case study</div>
      <h1><%= cs.headline %></h1>
      <p class="lede"><%= cs.lede %></p>
      <dl class="meta">
        <% cs.meta.forEach(function (m) { %>
          <dt><%= m.k %></dt><dd><%- m.v %></dd>
        <% }); %>
      </dl>
    </section>

    <section class="wrap wrap--narrow" style="padding-bottom: 56px;">
      <table class="numbers num" aria-label="Measured from the repository">
        <tbody>
          <% cs.numbers.forEach(function (n) { %>
            <tr><td class="v"><%= n.v %></td><td><%= n.k %></td></tr>
          <% }); %>
        </tbody>
      </table>
      <% if (cs.numbersNote) { %><p class="note"><%= cs.numbersNote %></p><% } %>
    </section>

    <section class="cs-section wrap wrap--narrow" style="padding-bottom: 0;">
      <div class="rule"></div>
      <h2>Decisions that mattered</h2>
      <% if (cs.decisionsIntro) { %><p><%= cs.decisionsIntro %></p><% } %>
    </section>

    <section class="wrap wrap--narrow decisions" style="padding-bottom: 56px; padding-top: 16px;">
      <% cs.decisions.forEach(function (d, i) { %>
        <article class="decision">
          <h3><%= i + 1 %>. <%= d.title %></h3>
          <% String(d.body).split('\n\n').forEach(function (para) { %><p><%- para %></p><% }); %>
          <% if (d.gates) { %>
            <div class="gates">
              <% d.gates.forEach(function (g) { %>
                <div class="gate"><b><%= g[0] %></b><span><%= g[1] %></span></div>
              <% }); %>
            </div>
          <% } %>
          <% if (d.evidence) { %><div class="evidence"><%- d.evidence %></div><% } %>
        </article>
      <% }); %>
    </section>

    <% (cs.sections || []).forEach(function (s) { %>
      <section class="cs-section wrap wrap--narrow">
        <div class="rule"></div>
        <h2><%= s.title %></h2>
        <p><%- s.body %></p>
      </section>
    <% }); %>

    <section class="cs-section wrap wrap--narrow" style="padding-bottom: 96px;">
      <div class="rule"></div>
      <h2>Links</h2>
      <div class="link-list">
        <% (cs.links || []).forEach(function (l) { %>
          <a href="<%= l.href %>" target="_blank" rel="noopener"><%= l.label %></a>
        <% }); %>
      </div>
      <% if (cs.linksNote) { %><p class="note" style="padding-top: 8px;"><%= cs.linksNote %></p><% } %>
    </section>
  <% } else { %>
    <section class="cs-hero wrap wrap--narrow">
      <% if (project.category) { %><div class="eyebrow"><%= project.category %></div><% } %>
      <h1><%= project.title %></h1>
      <p class="lede"><%= project.description %></p>
      <dl class="meta">
        <% if (project.date) { %><dt>When</dt><dd><%= project.date %></dd><% } %>
        <% if (project.technologies && project.technologies.length) { %>
          <dt>Stack</dt><dd><%= project.technologies.map(function (t) { return t.name; }).join(', ') %></dd>
        <% } %>
        <% if (project.liveUrl || project.githubUrl) { %>
          <dt>Links</dt>
          <dd>
            <% if (project.liveUrl) { %><a href="<%= project.liveUrl %>" target="_blank" rel="noopener">Live</a><% } %>
            <% if (project.liveUrl && project.githubUrl) { %> · <% } %>
            <% if (project.githubUrl) { %><a href="<%= project.githubUrl %>" target="_blank" rel="noopener">Repository</a><% } %>
          </dd>
        <% } %>
      </dl>
    </section>

    <% if (project.challenges) { %>
      <section class="cs-section wrap wrap--narrow">
        <div class="rule"></div>
        <h2>The problem</h2>
        <p><%= project.challenges %></p>
      </section>
    <% } %>

    <% if (project.technicalAchievements && project.technicalAchievements.length) { %>
      <section class="cs-section wrap wrap--narrow" style="padding-bottom: 96px;">
        <div class="rule"></div>
        <h2>What was built</h2>
        <ul class="cs-list">
          <% project.technicalAchievements.forEach(function (a) { %><li><%= a %></li><% }); %>
        </ul>
      </section>
    <% } %>
  <% } %>
  </main>

  <footer class="site-footer wrap wrap--narrow">
    <span>© 2026 Enock Mecheo</span>
    <% if (cs && cs.next) { %><a href="<%= cs.next.href %>"><%= cs.next.label %></a><% } else { %><a href="/portfolio">All projects</a><% } %>
  </footer>
</body>
</html>
