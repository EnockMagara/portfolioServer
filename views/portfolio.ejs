<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="utf-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0, viewport-fit=cover">
  <title>Projects — Enock Mecheo</title>
  <meta name="description" content="Every project, including the smaller ones: AI agents, ML pipelines, a network tool, an iOS app.">
  <meta name="author" content="Enock Mecheo">
  <link href="/assets/img/favicon.png" rel="icon">
  <link rel="preconnect" href="https://fonts.googleapis.com">
  <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
  <link href="https://fonts.googleapis.com/css2?family=Inter:wght@400;500;600&display=swap" rel="stylesheet">
  <link href="/assets/css/site.css" rel="stylesheet">
</head>
<body>
  <header class="site-header wrap">
    <a href="/" class="brand">Enock Mecheo</a>
    <nav class="back-nav" aria-label="Site">
      <a href="/#work">← Home</a>
    </nav>
  </header>

  <main>
    <section class="cs-hero wrap">
      <div class="eyebrow">All projects</div>
      <h1 style="font-size: 36px;">Everything, including the small ones.</h1>
      <p class="lede">The two platforms have their own pages. The rest are course projects, hackathon builds and experiments, kept here for completeness.</p>
    </section>

    <section class="wrap index-list" style="padding-bottom: 96px;">
      <% projects.forEach(function (p) { %>
        <article class="index-item">
          <div>
            <h3><a href="/project/<%= p.id %>"><%= p.shortTitle || p.title %></a></h3>
            <p><%= p.description.length > 220 ? p.description.slice(0, p.description.lastIndexOf(' ', 220)) + '…' : p.description %></p>
          </div>
          <div class="side">
            <% if (p.date) { %><%= p.date %><br><% } %>
            <% if (p.category) { %><%= p.category %><br><% } %>
            <% if (p.liveUrl) { %><a href="<%= p.liveUrl %>" target="_blank" rel="noopener">Live</a><% } %>
            <% if (p.liveUrl && p.githubUrl) { %> · <% } %>
            <% if (p.githubUrl) { %><a href="<%= p.githubUrl %>" target="_blank" rel="noopener">Repository</a><% } %>
          </div>
        </article>
      <% }); %>
    </section>
  </main>

  <footer class="site-footer wrap">
    <span>© 2026 Enock Mecheo</span>
    <a href="mailto:enockmecheo@nyu.edu">enockmecheo@nyu.edu</a>
  </footer>
</body>
</html>
